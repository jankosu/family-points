[Unit]
Description=Rodzinne Punkty - lokalny system punktowy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rodzinne-punkty
EnvironmentFile=/etc/rodzinne-punkty.env
ExecStart=/usr/bin/python3 -m gunicorn --workers 2 --bind 0.0.0.0:${PORT} app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
